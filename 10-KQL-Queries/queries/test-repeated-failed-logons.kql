// Synthetic data: all events fall in the same 10-minute window.
// Expected result: PC-C, LabUser, 10:10 UTC, FailedLogins = 5.
// PC-A and PC-B each have 3 failures and must remain separate.
datatable(
    TimeGenerated:datetime,
    Computer:string,
    Account:string,
    EventID:int
)
[
    datetime(2026-09-20T10:11:00Z), "PC-A", "LabUser", 4625,
    datetime(2026-09-20T10:12:00Z), "PC-A", "LabUser", 4625,
    datetime(2026-09-20T10:13:00Z), "PC-A", "LabUser", 4625,
    datetime(2026-09-20T10:11:00Z), "PC-B", "LabUser", 4625,
    datetime(2026-09-20T10:12:00Z), "PC-B", "LabUser", 4625,
    datetime(2026-09-20T10:13:00Z), "PC-B", "LabUser", 4625,
    datetime(2026-09-20T10:11:00Z), "PC-C", "LabUser", 4625,
    datetime(2026-09-20T10:12:00Z), "PC-C", "LabUser", 4625,
    datetime(2026-09-20T10:13:00Z), "PC-C", "LabUser", 4625,
    datetime(2026-09-20T10:14:00Z), "PC-C", "LabUser", 4625,
    datetime(2026-09-20T10:15:00Z), "PC-C", "LabUser", 4625
]
| where EventID == 4625
| summarize FailedLogins = count()
    by Computer, Account, bin(TimeGenerated, 10m)
| where FailedLogins >= 5
