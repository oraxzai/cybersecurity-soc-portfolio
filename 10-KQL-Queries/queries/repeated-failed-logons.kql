// Find accounts with at least 5 failed logons per fixed 10-minute window.
// No results means no group met the threshold.
// Matching results require investigation; they do not prove an attack.
// Fixed windows can split related failures across boundaries.
SecurityEvent
| where TimeGenerated > ago(2d)
| where EventID == 4625
| summarize FailedLogins = count() by Computer, Account, bin(TimeGenerated, 10m)
| where FailedLogins >= 5
